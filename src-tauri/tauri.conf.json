{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hiwara",
  "version": "0.3.7",
  "identifier": "com.qisato.hiwara",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hiwara",
        "width": 1000,
        "height": 600,
        "minWidth": 345,
        "minHeight": 475
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../public/fonts/*"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/installer.ico"
      }
    },
    "android": {
      "autoIncrementVersionCode": false,
      "minSdkVersion": 24,
      "versionCode": 8
    }
  }
}